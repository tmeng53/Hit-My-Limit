---
import Base from '../layouts/Base.astro';
import Limits from '../components/Limits.astro';

// Rendered on request and cached at the edge for 5 minutes.
export const prerender = false;
Astro.response.headers.set('cache-control', 'public, s-maxage=300, stale-while-revalidate=3600');
---
<Base lang="en" path="/limits" title="Limits">
  <Limits lang="en" />
</Base>
