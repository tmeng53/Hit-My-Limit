import Base from '../../layouts/Base.astro';
import HomeRich from '../../components/HomeRich.astro';
import { getChanges } from '../../lib/site';
import { SAMPLE } from '../../lib/sample';

const changes = await getChanges();
---
<Base lang="en" path="/preview">
  <HomeRich lang="en" data={SAMPLE} changes={changes} />
</Base>
