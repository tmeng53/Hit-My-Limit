---
// Design preview of the funnier home page, next to the current one at /.
import Base from '../../layouts/Base.astro';
import HomeRich from '../../components/HomeRich.astro';
import { getChanges } from '../../lib/site';
import { SAMPLE } from '../../lib/sample';

const changes = await getChanges();
---
<Base lang="en" path="/preview/fun">
  <HomeRich fun lang="en" data={SAMPLE} changes={changes} />
</Base>
