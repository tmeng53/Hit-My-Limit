---
import Base from '../layouts/Base.astro';
import { dbConfigured, unsubscribe } from '../lib/db';
import { t, type Lang } from '../lib/site';

// Linked from every alert email. Opening the link only asks; the button (or a mail app's one-click
// unsubscribe, which posts to this URL) does it, so link scanners can't unsubscribe anyone.
export const prerender = false;
Astro.response.headers.set('cache-control', 'no-store');

const token = Astro.url.searchParams.get('t') ?? '';
const post = Astro.request.method === 'POST';
let lang: Lang = 'en';
let state: 'ask' | 'done' | 'bad' = 'bad';
if (token && dbConfigured()) {
  try {
    const found = await unsubscribe(token, post);
    if (found) {
      lang = found === 'zh' ? 'zh' : 'en';
      state = post ? 'done' : 'ask';
    }
  } catch {}
}
if (state === 'bad') Astro.response.status = post ? 400 : 404;
const s = t[lang];
---
<Base lang={lang} path="/changes" title={s.unsubTitle}>
  <section>
    {state === 'ask' && (
      <form method="post">
        <p>{s.unsubAsk}</p>
        <button type="submit">{s.unsubButton}</button>
      </form>
    )}
    {state === 'done' && <p>{s.unsubDone}</p>}
    {state === 'bad' && <p>{s.unsubBad}</p>}
  </section>
</Base>

<style>
  section { padding: 56px 0; }
  p { margin: 0 0 20px; }
  button { height: 40px; padding: 0 12px; font: inherit; border: 1px solid var(--fg); border-radius: 0; background: var(--fg); color: var(--bg); cursor: pointer; }
</style>
