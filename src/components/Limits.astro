---
import { dbConfigured, groupStats, type GroupStats } from '../lib/db';
import { priceFor } from '../lib/pricing';
import { labelFor, MIN_GROUP, RECENT_DAYS } from '../lib/reports';
import { LABS, type Lang } from '../lib/site';

interface Props {
  lang: Lang;
  // Made-up groups for design work in development; the page reads the database otherwise.
  sample?: GroupStats[];
}
const { lang, sample } = Astro.props;

const text = {
  en: {
    h1: 'How much each plan gives before the limit',
    lead: `Median usage before the limit, from reports in the last ${RECENT_DAYS} days, priced at each model’s API rates. Self-reported, not official.`,
    other: 'Shared and resold accounts',
    otherNote: 'kept separate',
    cols: ['Plan', 'Limit', 'Usage', 'Middle half', 'vs 12 wk ago', 'Reports'],
    windows: { '5h': '5-hour', daily: 'daily', weekly: 'weekly', monthly: 'monthly' } as Record<string, string>,
    needs: (k: number) => `needs ${k} more report${k === 1 ? '' : 's'} with tokens`,
    tokens: (t: string) => `${t} tokens`,
    time: (t: string) => `out in ${t}`,
    noTokens: 'no token data yet',
    felt: (p: number) => `${p}% said sooner than usual`,
    empty: 'No reports yet.',
    share: 'share a hit →',
    closed: 'Reports are not open yet.',
    tokensNote: 'Usage is the tokens in Claude Code and Codex logs, sent by the command-line tool, priced at each model’s public API rates so cache reads and cheaper models count for what they are worth. The chat apps don’t log tokens, so they aren’t counted.',
  },
  zh: {
    h1: '每个套餐用完前能用多少',
    lead: `最近 ${RECENT_DAYS} 天大家报上来的数据，按各模型的 API 价格折成美元。不是官方数字。`,
    other: '共用和代理账号',
    otherNote: '单独统计',
    cols: ['套餐', '额度', '一般能用', '大多数人', '比 12 周前', '条数'],
    windows: { '5h': '5 小时', daily: '每天', weekly: '每周', monthly: '每月' } as Record<string, string>,
    needs: (k: number) => `还差 ${k} 条带 token 的`,
    tokens: (t: string) => `${t} token`,
    time: (t: string) => `${t} 用完`,
    noTokens: '还没有 token 数据',
    felt: (p: number) => `${p}% 说比平时用完得快`,
    empty: '还没有数据。',
    share: '报一下 →',
    closed: '还没开放提交，快了。',
    tokensNote: '用量是命令行工具从 Claude Code 和 Codex 日志里读到的 token，按各模型的 API 官方价格折算，这样缓存和便宜的模型不会被算多。网页和 App 没有 token 记录，所以不算在内。',
  },
}[lang];

let groups: GroupStats[] = sample ?? [];
let failed = false;
if (!sample && dbConfigured()) {
  try {
    groups = await groupStats();
  } catch (e) {
    console.error(e);
    failed = true;
  }
}
const own = groups.filter((g) => g.account === 'own');
const other = groups.filter((g) => g.account !== 'own');
const prefix = lang === 'zh' ? '/zh' : '';

// 95 -> "1h35", 45 -> "45m", 7020 -> "4d 21h"
function duration(m: number) {
  const d = Math.floor(m / 1440), h = Math.floor((m % 1440) / 60), mm = Math.round(m % 60);
  if (d) return `${d}d ${h}h`;
  return h ? `${h}h${String(mm).padStart(2, '0')}` : `${mm}m`;
}
// 6.1 -> "$6.10", 38 -> "$38", 1240 -> "$1.2k"
const money = (v: number) => (v >= 1000 ? `$${(v / 1000).toFixed(1)}k` : v >= 10 ? `$${Math.round(v)}` : `$${v.toFixed(2)}`);
function tokens(n: number) {
  if (n >= 1e9) return `${(n / 1e9).toFixed(1)}B`;
  if (n >= 1e6) return `${(n / 1e6).toFixed(1)}M`;
  if (n >= 1e3) return `${Math.round(n / 1e3)}K`;
  return String(n);
}
const BRAND: Record<string, string> = { anthropic: 'Claude', openai: 'ChatGPT', google: 'Gemini' };
const planName = (g: GroupStats) => `${BRAND[g.lab] ?? g.lab} ${labelFor(g.lab, 'plans', g.plan)}`;
const bar = (n: number) => '█'.repeat(Math.max(1, Math.round((10 * Math.min(n, MIN_GROUP)) / MIN_GROUP))).padEnd(10, '░');
const vs = (g: GroupStats) =>
  g.median_usd === null || g.prev_median_usd === null ? null : Math.round((100 * (g.median_usd - g.prev_median_usd)) / g.prev_median_usd);
// Plans with numbers first, then the ones still collecting reports.
const order = (rows: GroupStats[]) => [...rows].sort((a, b) => Number(a.median_usd === null) - Number(b.median_usd === null));
const sections = [{ rows: order(own), title: null }, { rows: order(other), title: text.other }].filter((s, i) => i === 0 || s.rows.length > 0);
---
<section class="intro">
  <h1>{text.h1}</h1>
  <p class="lead">{text.lead}</p>
</section>

{(!sample && !dbConfigured()) || failed ? (
  <p>{text.closed}</p>
) : own.length + other.length === 0 ? (
  <p>{text.empty} <a class="u" href={`${prefix}/share`}>{text.share}</a></p>
) : (
  <table>
    <thead><tr>{text.cols.map((c, i) => <th class={i >= 2 ? 'r' : undefined}>{c}</th>)}</tr></thead>
    {sections.map((s) => (
      <tbody>
        {s.title && <tr class="group"><td colspan="6">{s.title} · <span class="faint">{text.otherNote}</span></td></tr>}
        {s.rows.map((g) => {
          const d = vs(g);
          const extra = [
            g.median_tokens !== null && text.tokens(tokens(g.median_tokens)),
            g.median_minutes !== null && text.time(duration(g.median_minutes)),
            g.felt_sooner !== null && text.felt(g.felt_sooner),
          ].filter(Boolean).join(' · ');
          return g.median_usd === null ? (
            <tr class="pending">
              <td>{planName(g)}</td>
              <td class="win">{text.windows[g.window] ?? g.window}</td>
              <td class="r wait" colspan="3">{priceFor(g.lab, null) ? <><span class="bar" aria-hidden="true">{bar(g.token_reports)}</span> {text.needs(MIN_GROUP - g.token_reports)}</> : text.noTokens}</td>
              <td class="r n">{g.reports}</td>
            </tr>
          ) : (
            <tr>
              <td>{planName(g)}{extra && <span class="extra">{extra}</span>}</td>
              <td class="win">{text.windows[g.window] ?? g.window}</td>
              <td class="r big">{money(g.median_usd)}</td>
              <td class="r iqr">{money(g.p25_usd!)}–{money(g.p75_usd!)}</td>
              <td class={`r d ${d === null ? '' : d <= -2 ? 'minus' : d >= 2 ? 'plus' : ''}`}>{d === null ? '' : `${d > 0 ? '+' : d < 0 ? '−' : ''}${Math.abs(d)}%`}</td>
              <td class="r n">{g.reports}</td>
            </tr>
          );
        })}
      </tbody>
    ))}
  </table>
)}

<p class="notes"><a class="u" href={`${prefix}/share`}>{text.share}</a><br />{text.tokensNote}</p>

<style>
  .intro { padding: 56px 0 32px; }
  h1 { font: 600 28px/1.25 var(--font); letter-spacing: -0.02em; margin: 0 0 10px; }
  .lead { margin: 0; color: var(--muted); }
  .u { text-decoration: underline; text-underline-offset: 3px; }
  .faint { color: var(--faint); }
  .minus { color: var(--minus); }
  .plus { color: var(--plus); }
  table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  th { font-size: var(--s-sm); font-weight: 400; color: var(--muted); text-align: left; padding: 8px 0; border-bottom: 1px solid var(--fg); }
  td { padding: 11px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  th.r, td.r { text-align: right; }
  td.r + td.r, th.r + th.r { padding-left: 16px; }
  .win { color: var(--muted); }
  .big { font-weight: 600; font-size: 16px; }
  .iqr { color: var(--muted); font-size: var(--s-sm); }
  .extra { display: block; font-size: var(--s-sm); color: var(--muted); }
  .pending td { color: var(--faint); }
  .bar { letter-spacing: -1px; }
  .group td { border: 0; padding: 40px 0 6px; font-size: var(--s-sm); color: var(--muted); }
  .notes { margin-top: 32px; font-size: var(--s-sm); color: var(--muted); line-height: 1.9; }
  @media (max-width: 640px) {
    .intro { padding: 32px 0 24px; }
    h1 { font-size: 22px; }
    thead { display: none; }
    table, tbody, tr, td { display: block; }
    tr { display: grid; grid-template-columns: 1fr auto auto; column-gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--line); }
    td { padding: 0; border: 0; }
    td.r + td.r { padding-left: 0; }
    td:nth-child(1) { grid-column: 1 / 3; }
    td.win { grid-column: 1; grid-row: 2; font-size: var(--s-sm); }
    td.big { grid-column: 3; grid-row: 1; }
    td.iqr { grid-column: 3; grid-row: 2; }
    td.d { grid-column: 2; grid-row: 2; font-size: var(--s-sm); }
    td.n { display: none; }
    .pending td.wait { grid-column: 2 / 4; grid-row: 2; font-size: var(--s-sm); }
    .pending .bar { display: none; }
    .group { display: block; }
    .group td { padding: 32px 0 0; }
  }
</style>
