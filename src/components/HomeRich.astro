---
// A richer take on Home.astro: same content and order, with a color per lab, cards and a share panel.
import { LABS, MARK, isoDate, titleFor, type Change, type Lang } from '../lib/site';
import type { HomeData } from '../lib/home';

interface Props {
  lang: Lang;
  data: HomeData;
  changes: Change[];
  // Funnier copy, same numbers.
  fun?: boolean;
}
const { lang, data, changes, fun = false } = Astro.props;
const prefix = lang === 'zh' ? '/zh' : '';
const n = (x: number) => x.toLocaleString(lang === 'zh' ? 'zh-CN' : 'en-US');
const labName = (lab: string) => (LABS as Record<string, { en: string; zh: string }>)[lab]?.[lang] ?? lab;

function duration(m: number) {
  const h = Math.floor(m / 60), mm = Math.round(m % 60);
  return [h && `${h}h`, mm && `${mm}m`].filter(Boolean).join(' ') || '0m';
}
const avg = (xs: (number | null)[]) => {
  const v = xs.filter((x): x is number => x !== null);
  return v.length ? v.reduce((a, b) => a + b, 0) / v.length : null;
};

// Each lab's verdict: the last four weeks against the first four on the chart.
const { weeks } = data.trend;
const verdicts = data.trend.labs.map((l) => {
  const before = avg(l.minutes.slice(0, 4));
  const after = avg(l.minutes.slice(-4));
  const change = before && after ? Math.round((100 * (after - before)) / before) : null;
  const dir = change === null ? null : change <= -5 ? 'tighter' : change >= 5 ? 'looser' : 'same';
  return { ...l, before, after, change, dir };
});
const known = verdicts.filter((v) => v.dir);
const overall = known.every((v) => v.dir === 'tighter') ? 'tighter' : known.every((v) => v.dir === 'looser') ? 'looser' : 'mixed';
const nowFelt = data.sooner.at(-1);

const base = {
  en: {
    headline: { tighter: 'Usage limits are getting tighter', looser: 'Usage limits are getting looser', mixed: 'Usage limits are changing' }[overall],
    sub: 'How long people last in a 5-hour window before hitting the limit. Self-reported, not official numbers.',
    sample: 'Sample data',
    stats: [
      [n(data.reports), 'reports'],
      [n(data.people), 'people'],
      [nowFelt ? `${nowFelt.pct}%` : '–', 'said last week came sooner than usual'],
    ],
    sooner: (c: number) => `${Math.abs(c)}% sooner`,
    later: (c: number) => `${Math.abs(c)}% later`,
    same: 'About the same',
    now: 'now',
    was: 'was',
    noData: 'Not enough reports yet',
    noDataHint: 'Share one when you hit a limit',
    since: `vs ${weeks.length} weeks ago`,
    chartTitle: 'Time before hitting the 5-hour limit',
    chartSub: 'Median by week. Ticks are plan changes from the change log.',
    changesTitle: 'Latest plan changes',
    dirs: { tighter: 'tighter', looser: 'looser', mixed: 'mixed', neutral: 'no change' },
    allChanges: 'All changes',
    byPlan: 'Numbers by plan and model',
    shareTitle: 'Hit a limit? Add yours.',
    shareSub: 'Every report makes the numbers above more accurate. Nothing personal is sent.',
    terminal: 'From your terminal',
    terminalHint: 'Reads your Claude Code and Codex logs and asks before sending.',
    web: 'Or in the browser',
    webHint: 'Six fields, about a minute.',
    webButton: 'Open the form',
    copy: 'Copy',
    copied: 'Copied',
  },
  zh: {
    headline: { tighter: '用量额度在收紧', looser: '用量额度在放宽', mixed: '用量额度有升有降' }[overall],
    sub: '在 5 小时额度周期里，大家用多久会触发上限。由用户自行报告，不是官方数字。',
    sample: '示例数据',
    stats: [
      [n(data.reports), '份报告'],
      [n(data.people), '人参与'],
      [nowFelt ? `${nowFelt.pct}%` : '–', '的人说上周比平时更早触发'],
    ],
    sooner: (c: number) => `提前 ${Math.abs(c)}%`,
    later: (c: number) => `推迟 ${Math.abs(c)}%`,
    same: '基本不变',
    now: '现在',
    was: '之前',
    noData: '报告还不够',
    noDataHint: '触发上限时分享一下',
    since: `与 ${weeks.length} 周前相比`,
    chartTitle: '触发 5 小时上限前的用时',
    chartSub: '每周中位数。刻度是变化记录里的方案变化。',
    changesTitle: '最近的方案变化',
    dirs: { tighter: '收紧', looser: '放宽', mixed: '有升有降', neutral: '不变' },
    allChanges: '全部变化',
    byPlan: '按方案和模型查看',
    shareTitle: '触发上限了？分享一下。',
    shareSub: '每份报告都会让上面的数字更准确。不会发送任何个人信息。',
    terminal: '在终端里',
    terminalHint: '读取 Claude Code 和 Codex 的日志，发送前会先问你。',
    web: '或者在网页上',
    webHint: '六个字段，大约一分钟。',
    webButton: '打开表单',
    copy: '复制',
    copied: '已复制',
  },
}[lang];

const jokes = {
  en: {
    kicker: { tighter: 'Time to touch grass.', looser: 'Less grass this month.', mixed: 'Some of you can stay inside.' }[overall],
    headline: { tighter: 'Limits are getting tighter', looser: 'Limits are getting looser', mixed: 'Limits are moving around' }[overall],
    sub: 'Based on what people report when they hit a limit.',
    stats: [
      [n(data.reports), 'reports'],
      [n(data.people), 'people'],
      [nowFelt ? `${nowFelt.pct}%` : '–', 'said “already?” last week'],
    ],
    lost: null,
    noData: 'No reports yet',
    noDataHint: 'Use Gemini? Send one',
    chartTitle: 'How long until you’re locked out',
    chartSub: 'Weekly median. Dots up top are plan changes.',
    changesTitle: 'Recent plan changes',
    shareTitle: 'Locked out right now? Send it in.',
    shareSub: 'Takes a minute. Not like you’re doing anything else.',
    terminal: 'Terminal',
    terminalHint: 'Reads your Claude Code and Codex logs. Asks before sending.',
    web: 'Or the form',
    webHint: 'Six fields.',
  },
  zh: {
    kicker: { tighter: '又该摸鱼了。', looser: '摸鱼时间变少了。', mixed: '有人摸鱼，有人加班。' }[overall],
    headline: { tighter: '额度在缩水', looser: '额度变多了', mixed: '额度有涨有跌' }[overall],
    sub: '数据来自大家撞上限时交的报告。',
    stats: [
      [n(data.reports), '份报告'],
      [n(data.people), '人'],
      [nowFelt ? `${nowFelt.pct}%` : '–', '的人上周说「这就没了？」'],
    ],
    lost: null,
    since: `跟 ${weeks.length} 周前比`,
    was: '以前',
    noData: '还没有报告',
    noDataHint: '用 Gemini 的来一份',
    chartTitle: '多久就用完了',
    chartSub: '每周中位数。上面的点是方案变化。',
    changesTitle: '最近的方案变化',
    shareTitle: '正在摸鱼？顺手报一下。',
    shareSub: '只要一分钟，反正离重置还早。',
    terminal: '终端',
    terminalHint: '读 Claude Code 和 Codex 的日志，发之前会问你。',
    web: '或者填表',
    webHint: '六个空。',
    webButton: '去填表',
  },
}[lang];
const text = { ...base, kicker: null as string | null, lost: null as ((m: number) => string) | null, ...(fun ? jokes : {}) };

// The chart is drawn twice, wide and narrow, so text stays readable on phones. The y axis runs from 0 to 3 hours.
const YMAX = 180;
const sizes = [
  { cls: 'wide', W: 880, H: 280, L: 40, R: 150, T: 20, B: 28, every: 2 },
  { cls: 'narrow', W: 360, H: 240, L: 28, R: 92, T: 20, B: 28, every: 4 },
].map((g) => ({
  ...g,
  x: (i: number) => g.L + (i * (g.W - g.L - g.R)) / (weeks.length - 1),
  y: (m: number) => g.T + (g.H - g.T - g.B) * (1 - m / YMAX),
  step: (g.W - g.L - g.R) / (weeks.length - 1),
}));
const plotted = verdicts.filter((v) => v.minutes.some((m) => m !== null));
const path = (g: (typeof sizes)[number], ms: (number | null)[]) =>
  ms.map((m, i) => (m === null ? '' : `${i && ms[i - 1] !== null ? 'L' : 'M'}${g.x(i).toFixed(1)},${g.y(m).toFixed(1)}`)).join('');
const color = (lab: string) => `var(--lab-${lab})`;

// A small line per lab card, scaled to its own range so the direction is easy to see.
const spark = (ms: (number | null)[]) => {
  const v = ms.filter((m): m is number => m !== null);
  if (v.length < 2) return null;
  const lo = Math.min(...v), hi = Math.max(...v), W = 120, H = 36;
  const pts = ms.map((m, i) => (m === null ? null : [(i * W) / (ms.length - 1), 4 + (H - 8) * (1 - (m - lo) / (hi - lo || 1))]));
  const d = pts.map((p, i) => (p ? `${i && pts[i - 1] ? 'L' : 'M'}${p[0].toFixed(1)},${p[1].toFixed(1)}` : '')).join('');
  const last = pts.at(-1);
  return { d, last, W, H };
};

const start = Date.parse(`${weeks[0]}T00:00:00Z`);
const events = changes
  .filter((c) => c.data.date.getTime() >= start && c.data.direction !== 'neutral')
  .map((c) => ({ c, i: Math.min(weeks.length - 1, Math.floor((c.data.date.getTime() - start) / (7 * 86400000))) }));
const weekLabel = (w: string) => w.slice(5).replace('-', '/');

const latest = (Object.keys(LABS) as (keyof typeof LABS)[])
  .map((lab) => changes.find((c) => c.data.lab === lab))
  .filter((c): c is Change => !!c)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<div class="rich">
<section class="hero">
  {data.sample && <span class="tag">{text.sample}</span>}
  <h1>{fun ? (
    <svg class="grass-mark" viewBox="0 0 64 64" aria-hidden="true">
      <rect x="9" y="38" width="46" height="12" rx="3" class="bar" />
      <path d="M17 38 Q16 30 12 25 M24 38 Q24 27 28 20 M31 38 Q33 31 38 28 M44 38 Q43 30 47 23 M50 38 Q51 34 54 32" class="blades" />
    </svg>
  ) : <span class={`badge ${overall}`}>{overall === 'tighter' ? MARK.tighter : overall === 'looser' ? MARK.looser : MARK.mixed}</span>}{text.kicker ?? text.headline}</h1>
  {text.kicker && <p class="kicker">{text.headline}</p>}
  <p class="sub">{text.sub}</p>
  <dl class="stats">
    {text.stats.map(([v, k]) => <div><dt>{v}</dt><dd>{k}</dd></div>)}
  </dl>
</section>

<section class="cards">
  {verdicts.map((v) => {
    const s = spark(v.minutes);
    return (
      <div class="card verdict" style={`--c:${color(v.lab)}`}>
        <span class="lab"><i></i>{labName(v.lab)}</span>
        {v.dir === null ? (
          <>
            <span class="big none">{text.noData}</span>
            <a class="u small muted" href={`${prefix}/share`}>{text.noDataHint} →</a>
          </>
        ) : (
          <>
            <span class={`big ${v.dir}`}>
              {v.dir === 'tighter' ? text.sooner(v.change!) : v.dir === 'looser' ? text.later(v.change!) : text.same}
            </span>
            <span class="small muted">{text.since}</span>
            {text.lost && v.after! < v.before! && <span class="quip">{text.lost(v.before! - v.after!)}</span>}
            <div class="foot">
              <span class="small">
                <b>{duration(v.after!)}</b> <span class="muted">{text.now}</span><br />
                <span class="muted">{duration(v.before!)} {text.was}</span>
              </span>
              {s && (
                <svg class="spark" viewBox={`-4 0 ${s.W + 8} ${s.H}`} aria-hidden="true">
                  <path d={s.d} fill="none" stroke={color(v.lab)} stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
                  <circle cx={s.last![0]} cy={s.last![1]} r="3.5" fill={color(v.lab)} />
                </svg>
              )}
            </div>
          </>
        )}
      </div>
    );
  })}
</section>

<section class="card chart">
  <div class="head">
    <div>
      <h2>{text.chartTitle}</h2>
      <p class="small muted">{text.chartSub}</p>
    </div>
    <p class="legend">
      {plotted.map((v) => <span><i style={`background:${color(v.lab)}`}></i>{labName(v.lab)}</span>)}
    </p>
  </div>
  {sizes.map((g) => (
  <svg viewBox={`0 0 ${g.W} ${g.H}`} class={g.cls} role="img" aria-label={text.chartTitle}>
    {[60, 120, 180].map((m) => (
      <g>
        <line x1={g.L} x2={g.W - g.R} y1={g.y(m)} y2={g.y(m)} class="grid" />
        <text x={g.L - 8} y={g.y(m) + 4} class="axis" text-anchor="end">{m / 60}h</text>
      </g>
    ))}
    <line x1={g.L} x2={g.W - g.R} y1={g.y(0)} y2={g.y(0)} class="base" />
    {fun && lang === 'zh' && <path class="fish" d={Array.from({ length: Math.floor((g.W - g.L - g.R) / 40) }, (_, k) => {
      const x = g.L + 10 + k * 40, y = g.y(0) - 7 - (k % 2) * 4;
      return `M${x},${y} q8,-6 16,0 q-8,6 -16,0 Z M${x + 15},${y} l7,-5 v10 Z`;
    }).join(' ')} />}
    {fun && lang !== 'zh' && <path class="tufts" d={Array.from({ length: Math.floor((g.W - g.L - g.R) / 18) }, (_, k) => {
      const x = g.L + 9 + k * 18, y = g.y(0), h = 5 + ((k * 7) % 4);
      return `M${x - 3},${y} q-1,-${h - 1} -3,-${h} M${x},${y} q0,-${h + 2} 2,-${h + 3} M${x + 3},${y} q1,-${h - 2} 3,-${h - 1}`;
    }).join(' ')} />}
    {weeks.map((w, i) => i % g.every === 0 && <text x={g.x(i)} y={g.H - 8} class="axis" text-anchor="middle">{weekLabel(w)}</text>)}
    {events.map(({ c, i }) => (
      <g class="event">
        <line x1={g.x(i)} x2={g.x(i)} y1={g.T} y2={g.y(0)} />
        <circle cx={g.x(i)} cy={g.T - 6} r="8" class={c.data.direction} />
        <text x={g.x(i)} y={g.T - 2} text-anchor="middle">{MARK[c.data.direction]}</text>
        <title>{`${isoDate(c.data.date)} ${labName(c.data.lab)}: ${titleFor(c, lang)}`}</title>
      </g>
    ))}
    {plotted.map((v) => {
      const last = v.minutes.length - 1;
      return (
        <g>
          <path d={path(g, v.minutes)} fill="none" stroke={color(v.lab)} stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" />
          <circle cx={g.x(last)} cy={g.y(v.minutes[last]!)} r="5" fill={color(v.lab)} class="end" />
          <text x={g.x(last) + 12} y={g.y(v.minutes[last]!) + 4} class="label">{g.cls === 'wide' ? `${labName(v.lab)} ` : ''}<tspan class="strong">{duration(v.minutes[last]!)}</tspan></text>
        </g>
      );
    })}
    {weeks.map((w, i) => (
      <rect x={g.x(i) - g.step / 2} y={g.T} width={g.step} height={g.H - g.T - g.B} class="hit">
        <title>{[weekLabel(w), ...plotted.map((v) => `${labName(v.lab)} ${v.minutes[i] === null ? '–' : duration(v.minutes[i]!)}`)].join('\n')}</title>
      </rect>
    ))}
  </svg>
  ))}
</section>

<section>
  <div class="row-head">
    <h2>{text.changesTitle}</h2>
    <a class="u small muted" href={`${prefix}/changes`}>{text.allChanges} →</a>
  </div>
  <ul class="changes">
    {latest.map((c) => (
      <li>
        <a class="card change" href={`${prefix}/changes#${c.id}`}>
          <span class="meta">
            <span class="lab" style={`--c:${color(c.data.lab)}`}><i></i>{labName(c.data.lab)}</span>
            <time class="muted" datetime={isoDate(c.data.date)}>{isoDate(c.data.date)}</time>
          </span>
          <span class="title">{titleFor(c, lang)}</span>
          <span class={`pill ${c.data.direction}`}>{MARK[c.data.direction]} {text.dirs[c.data.direction]}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<section class="card share">
  <div class="share-head">
    <h2 class="big-h">{text.shareTitle}</h2>
    <p class="muted">{text.shareSub}</p>
  </div>
  <div class="ways">
    <div class="way">
      <span class="small muted">{text.terminal}</span>
      <div class="cmd"><code><span class="muted">$</span> npx hitmylimit</code><button type="button" data-copy="npx hitmylimit" data-done={text.copied}>{text.copy}</button></div>
      <span class="small muted">{text.terminalHint}</span>
    </div>
    <div class="way">
      <span class="small muted">{text.web}</span>
      <a class="button" href={`${prefix}/share`}>{text.webButton} →</a>
      <span class="small muted">{text.webHint}</span>
    </div>
  </div>
</section>

<section class="links">
  <a class="u" href={`${prefix}/limits`}>{text.byPlan} →</a>
  <a class="u" href={`${prefix}/changes`}>{text.allChanges} →</a>
</section>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
    const label = b.textContent;
    b.addEventListener('click', async () => {
      await navigator.clipboard.writeText(b.dataset.copy!);
      b.textContent = b.dataset.done!;
      setTimeout(() => (b.textContent = label), 1500);
    });
  });
</script>

<style>
  /* Lab colors checked for color-blind separation in both modes. Google stays grey until it has data. */
  .rich {
    --lab-anthropic: #d4622a;
    --lab-openai: #2a78d6;
    --lab-google: #9a9a9a;
    --panel: #f7f7f5;
    --panel-line: #ebebe8;
    --sans: 'IBM Plex Sans', system-ui, -apple-system, 'PingFang SC', 'Noto Sans SC', 'Microsoft YaHei', sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    .rich {
      --lab-anthropic: #e0703a;
      --lab-openai: #4a90e8;
      --lab-google: #6e6e6e;
      --panel: #151515;
      --panel-line: #242424;
    }
  }
  .muted { color: var(--muted); }
  .small { font-size: var(--s-sm); }
  .u { text-decoration: underline; text-underline-offset: 3px; }
  section + section { margin-top: 40px; }
  h2 { font: 600 17px/1.3 var(--sans); margin: 0; }
  .card { background: var(--panel); border: 1px solid var(--panel-line); border-radius: 14px; }
  .lab { display: inline-flex; align-items: center; gap: 8px; font-size: var(--s-sm); }
  .lab i { width: 10px; height: 10px; border-radius: 50%; background: var(--c); }

  .hero { padding: 56px 0 0; }
  .tag { display: inline-block; margin-bottom: 16px; padding: 2px 10px; border-radius: 999px; background: var(--panel); border: 1px solid var(--panel-line); font-size: 12px; color: var(--muted); }
  h1 { display: flex; align-items: center; gap: 16px; font: 600 44px/1.15 var(--sans); letter-spacing: -0.02em; margin: 0 0 14px; }
  .badge { flex: none; display: inline-grid; place-items: center; width: 52px; height: 52px; border-radius: 14px; font: 500 34px/1 var(--font); }
  .badge.tighter { color: var(--minus); background: color-mix(in srgb, var(--minus) 12%, transparent); }
  .badge.looser { color: var(--plus); background: color-mix(in srgb, var(--plus) 12%, transparent); }
  .badge.mixed { color: var(--muted); background: var(--panel); }
  .grass-mark { flex: none; width: 60px; height: 60px; border-radius: 14px; background: var(--panel); border: 1px solid var(--panel-line); }
  .grass-mark .bar { fill: var(--fg); }
  .grass-mark .blades { fill: none; stroke: var(--plus); stroke-width: 3.5; stroke-linecap: round; }
  .fish { fill: var(--muted); opacity: 0.5; }
  .tufts { fill: none; stroke: var(--plus); stroke-width: 1.4; stroke-linecap: round; opacity: 0.55; }
  .kicker { margin: -4px 0 14px; font: 500 24px/1.3 var(--sans); }
  .quip { margin-top: 8px; font: 15px/1.4 var(--sans); }
  .sub { margin: 0; max-width: 60ch; color: var(--muted); font: 16px/1.55 var(--sans); }
  .stats { display: flex; flex-wrap: wrap; gap: 12px 40px; margin: 28px 0 0; }
  .stats div { display: flex; align-items: baseline; gap: 10px; }
  .stats dt { font: 600 22px var(--sans); }
  .stats dd { margin: 0; font-size: var(--s-sm); color: var(--muted); }

  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: 40px; }
  .verdict { display: flex; flex-direction: column; gap: 4px; padding: 20px; position: relative; overflow: hidden; }
  .verdict::before { content: ''; position: absolute; inset: 0 0 auto; height: 4px; background: var(--c); }
  .verdict .lab { margin-bottom: 10px; }
  .verdict .big { font: 600 30px/1.15 var(--sans); letter-spacing: -0.01em; }
  .verdict .big.tighter { color: var(--minus); }
  .verdict .big.looser { color: var(--plus); }
  .verdict .big.none { font-size: 19px; font-weight: 500; color: var(--muted); margin-bottom: 4px; }
  .foot { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--panel-line); }
  .foot b { font-weight: 500; }
  .spark { width: 112px; height: 36px; flex: none; overflow: visible; }

  .chart { padding: 24px 24px 16px; }
  .head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap; }
  .head p { margin: 4px 0 0; }
  .legend { display: flex; gap: 20px; font-size: var(--s-sm); }
  .legend i { display: inline-block; width: 16px; height: 3px; border-radius: 2px; margin-right: 8px; vertical-align: middle; }
  svg.wide, svg.narrow { display: block; width: 100%; height: auto; margin-top: 16px; overflow: visible; }
  svg.narrow { display: none; }
  .grid { stroke: var(--panel-line); stroke-width: 1; }
  .base { stroke: var(--muted); stroke-width: 1; }
