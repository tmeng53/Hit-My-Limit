---
import { LABS, t, titleFor, type Change, type Lang } from '../lib/site';

interface Props {
  lang: Lang;
  changes: Change[];
}
const { lang, changes } = Astro.props;
const s = t[lang];

// Swimlane per lab, time on x. Everything is computed at build time, so the page ships plain SVG.
const W = 1000, left = 112, right = 24, top = 34, lane = 46;
const labs = Object.keys(LABS) as (keyof typeof LABS)[];
const H = top + lane * labs.length + 8;
const times = changes.map((c) => c.data.date.getTime());
const lo = new Date(Math.min(...times));
const start = Date.UTC(lo.getUTCFullYear(), lo.getUTCMonth(), 1);
const hiD = new Date(Math.max(...times, Date.now()));
const end = Date.UTC(hiD.getUTCFullYear(), hiD.getUTCMonth() + 1, 1);
const x = (ms: number) => left + ((ms - start) / (end - start)) * (W - left - right);
const y = (lab: string) => top + lane * labs.indexOf(lab as any) + lane / 2;

const months: { ms: number; label: string; year: boolean }[] = [];
for (let d = new Date(start); d.getTime() <= end; d.setUTCMonth(d.getUTCMonth() + 1)) {
  const m = d.getUTCMonth();
  months.push({
    ms: d.getTime(),
    label: m === 0 || months.length === 0 ? String(d.getUTCFullYear()) : String(m + 1).padStart(2, '0'),
    year: m === 0 || months.length === 0,
  });
}
const r = 7;
---
<figure class="timeline">
  <div class="wrap">
  <div class="pins" aria-hidden="true">
    {labs.map((lab) => <span style={`top:${(y(lab) / H) * 100}%`}>{LABS[lab][lang]}</span>)}
  </div>
  <div class="scroll">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={s.tagline}>
    {months.map((m) => (
      <g>
        <line x1={x(m.ms)} x2={x(m.ms)} y1={top - 6} y2={H - 8} class={m.year ? 'tick year' : 'tick'} />
        <text x={x(m.ms) + 4} y={top - 12} class={m.year ? 'tlabel year' : 'tlabel'}>{m.label}</text>
      </g>
    ))}
    {labs.map((lab) => (
      <g>
        <line x1={left} x2={W - right} y1={y(lab)} y2={y(lab)} class="lane" />
        <text x={0} y={y(lab) + 5} class="lname">{LABS[lab][lang]}</text>
      </g>
    ))}
    {changes.map((c) => {
      const cx = x(c.data.date.getTime()), cy = y(c.data.lab), d = c.data.direction;
      return (
        <a href={`#${c.id}`} class={`m ${d}`}>
          <title>{c.data.date.toISOString().slice(0, 10)} · {titleFor(c, lang)}</title>
          {d === 'tighter' && <path d={`M${cx - r} ${cy - r * 0.8}H${cx + r}L${cx} ${cy + r}Z`} />}
          {d === 'looser' && <path d={`M${cx - r} ${cy + r * 0.8}H${cx + r}L${cx} ${cy - r}Z`} />}
          {d === 'mixed' && <path d={`M${cx} ${cy - r}L${cx + r} ${cy}L${cx} ${cy + r}L${cx - r} ${cy}Z`} />}
          {d === 'neutral' && <circle cx={cx} cy={cy} r={r - 2} />}
        </a>
      );
    })}
  </svg>
  </div>
  </div>
  <figcaption>
    <span><i class="k tighter"></i>{s.tighter}</span>
    <span><i class="k looser"></i>{s.looser}</span>
    <span><i class="k mixed"></i>{s.mixed}</span>
    <span><i class="k neutral"></i>{s.neutral}</span>
  </figcaption>
</figure>

<script>
  // On narrow screens the chart scrolls sideways; start at the most recent months.
  for (const el of document.querySelectorAll<HTMLElement>('.timeline .scroll')) el.scrollLeft = el.scrollWidth;
</script>

<style>
  .timeline { margin: 0; }
  svg { display: block; width: 100%; height: auto; overflow: visible; }
  .tick { stroke: var(--hair); stroke-width: 1; }
  .tick.year { stroke: var(--ink); }
  .tlabel { font: 12px var(--mono); fill: var(--muted); }
  .tlabel.year { fill: var(--ink); font-weight: 500; }
  .lane { stroke: var(--ink); stroke-width: 1; }
  .lname { font: 500 14px var(--mono); fill: var(--ink); letter-spacing: 0.02em; }
  .m path, .m circle { stroke: var(--paper); stroke-width: 2; paint-order: stroke; transition: transform 0.12s; transform-box: fill-box; transform-origin: center; }
  .m:hover path, .m:hover circle, .m:focus-visible path { transform: scale(1.5); }
  .m.tighter path { fill: var(--tighter); }
  .m.looser path { fill: var(--looser); }
  .m.mixed path { fill: var(--mixed); }
  .m.neutral circle { fill: var(--paper); stroke: var(--ink); stroke-width: 1.75; }
  figcaption { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 12px; font: 12px var(--mono); color: var(--muted); }
  .k { display: inline-block; width: 10px; height: 10px; margin-right: 6px; vertical-align: -1px; }
  .k.tighter { background: var(--tighter); clip-path: polygon(0 0, 100% 0, 50% 100%); }
  .k.looser { background: var(--looser); clip-path: polygon(50% 0, 100% 100%, 0 100%); }
  .k.mixed { background: var(--mixed); clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%); }
  .k.neutral { border: 1.5px solid var(--ink); border-radius: 50%; }
  .wrap { position: relative; }
  .scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .pins { display: none; }
  @media (max-width: 640px) {
    svg { min-width: 680px; }
    .pins { display: block; position: absolute; inset: 0 auto 0 0; z-index: 1; pointer-events: none; }
    .pins span { position: absolute; left: 0; transform: translateY(-50%); padding: 2px 6px 2px 0; background: var(--paper); font: 500 11px var(--mono); }
  }
</style>
