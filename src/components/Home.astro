---
import { LABS, MARK, isoDate, titleFor, type Change, type Lang } from '../lib/site';
import type { HomeData } from '../lib/home';

interface Props {
  lang: Lang;
  data: HomeData;
  changes: Change[];
}
const { lang, data, changes } = Astro.props;
const prefix = lang === 'zh' ? '/zh' : '';
const n = (x: number) => x.toLocaleString(lang === 'zh' ? 'zh-CN' : 'en-US');
const labName = (lab: string) => (LABS as Record<string, { en: string; zh: string }>)[lab]?.[lang] ?? lab;

function duration(m: number) {
  const h = Math.floor(m / 60), mm = Math.round(m % 60);
  return [h && `${h}h`, mm && `${mm}m`].filter(Boolean).join(' ') || '0m';
}
const avg = (xs: (number | null)[]) => {
  const v = xs.filter((x): x is number => x !== null);
  return v.length ? v.reduce((a, b) => a + b, 0) / v.length : null;
};

// Each lab's verdict: the last four weeks against the first four on the chart.
const { weeks } = data.trend;
const verdicts = data.trend.labs.map((l) => {
  const before = avg(l.minutes.slice(0, 4));
  const after = avg(l.minutes.slice(-4));
  const change = before && after ? Math.round((100 * (after - before)) / before) : null;
  const dir = change === null ? null : change <= -5 ? 'tighter' : change >= 5 ? 'looser' : 'same';
  return { ...l, before, after, change, dir };
});
const known = verdicts.filter((v) => v.dir);
const overall = known.every((v) => v.dir === 'tighter') ? 'tighter' : known.every((v) => v.dir === 'looser') ? 'looser' : 'mixed';

const text = {
  en: {
    headline: { tighter: 'Usage limits are getting tighter', looser: 'Usage limits are getting looser', mixed: 'Usage limits are changing' }[overall],
    sub: `How long people last in a 5-hour window before hitting the limit, from ${n(data.reports)} reports by ${n(data.people)} people. Self-reported, not official numbers.`,
    sample: 'Sample data',
    sooner: (c: number) => `${Math.abs(c)}% sooner`,
    later: (c: number) => `${Math.abs(c)}% later`,
    same: 'About the same',
    was: (a: number, b: number) => `${duration(a)} into the window, was ${duration(b)}`,
    noData: 'Not enough reports yet',
    since: `compared with ${weeks.length} weeks ago`,
    chartTitle: 'Time before hitting the 5-hour limit, median by week',
    eventsNote: 'Ticks on the chart are plan changes from the change log.',
    feel: (now: number) => `${now}% of people who hit a limit last week said it came sooner than usual.`,
    changesTitle: 'Latest plan changes',
    allChanges: 'All changes',
    byPlan: 'Numbers by plan and model',
    share: 'Share when you hit a limit',
  },
  zh: {
    headline: { tighter: '用量额度在收紧', looser: '用量额度在放宽', mixed: '用量额度有升有降' }[overall],
    sub: `在 5 小时额度周期里，大家用多久会触发上限。根据 ${n(data.people)} 人提交的 ${n(data.reports)} 份报告，由用户自行报告，不是官方数字。`,
    sample: '示例数据',
    sooner: (c: number) => `提前 ${Math.abs(c)}%`,
    later: (c: number) => `推迟 ${Math.abs(c)}%`,
    same: '基本不变',
    was: (a: number, b: number) => `周期开始后 ${duration(a)}，之前是 ${duration(b)}`,
    noData: '报告还不够',
    since: `与 ${weeks.length} 周前相比`,
    chartTitle: '触发 5 小时上限前的用时，每周中位数',
    eventsNote: '图上的刻度是变化记录里的方案变化。',
    feel: (now: number) => `上周触发上限的人中，${now}% 说比平时更早。`,
    changesTitle: '最近的方案变化',
    allChanges: '全部变化',
    byPlan: '按方案和模型查看',
    share: '触发上限时分享一下',
  },
}[lang];

// The chart is drawn twice, wide and narrow, so text stays readable on phones. The y axis runs from 0 to 3 hours.
const YMAX = 180;
const sizes = [
  { cls: 'wide', W: 880, H: 260, L: 40, R: 150, T: 16, B: 28, every: 2 },
  { cls: 'narrow', W: 360, H: 240, L: 28, R: 92, T: 16, B: 28, every: 4 },
].map((g) => ({
  ...g,
  x: (i: number) => g.L + (i * (g.W - g.L - g.R)) / (weeks.length - 1),
  y: (m: number) => g.T + (g.H - g.T - g.B) * (1 - m / YMAX),
  step: (g.W - g.L - g.R) / (weeks.length - 1),
}));
const plotted = verdicts.filter((v) => v.minutes.some((m) => m !== null));
const path = (g: (typeof sizes)[number], ms: (number | null)[]) =>
  ms.map((m, i) => (m === null ? '' : `${i && ms[i - 1] !== null ? 'L' : 'M'}${g.x(i).toFixed(1)},${g.y(m).toFixed(1)}`)).join('');
const tone = (i: number) => (i === 0 ? 'var(--fg)' : 'var(--muted)');
// Change-log entries inside the chart's range, placed at their week.
const start = Date.parse(`${weeks[0]}T00:00:00Z`);
const events = changes
  .filter((c) => c.data.date.getTime() >= start && c.data.direction !== 'neutral')
  .map((c) => ({ c, i: Math.min(weeks.length - 1, Math.floor((c.data.date.getTime() - start) / (7 * 86400000))) }));
const weekLabel = (w: string) => w.slice(5).replace('-', '/');
const nowFelt = data.sooner.at(-1);

const latest = (Object.keys(LABS) as (keyof typeof LABS)[])
  .map((lab) => changes.find((c) => c.data.lab === lab))
  .filter((c): c is Change => !!c)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<section class="hero">
  <h1><span class={`mark ${overall}`}>{overall === 'tighter' ? MARK.tighter : overall === 'looser' ? MARK.looser : MARK.mixed}</span> {text.headline}</h1>
  <p class="sub">{text.sub}{data.sample && <span class="tag">{text.sample}</span>}</p>
</section>

<section class="verdicts">
  {verdicts.map((v) => (
    <div class="verdict">
      <span class="lab">{labName(v.lab)}</span>
      {v.dir === null ? (
        <span class="big muted">{text.noData}</span>
      ) : (
        <>
          <span class={`big ${v.dir}`}>
            {v.dir === 'tighter' ? `${MARK.tighter} ${text.sooner(v.change!)}` : v.dir === 'looser' ? `${MARK.looser} ${text.later(v.change!)}` : `${MARK.neutral} ${text.same}`}
          </span>
          <span class="muted small">{text.since}</span>
          <span class="muted small">{text.was(v.after!, v.before!)}</span>
        </>
      )}
    </div>
  ))}
</section>

<section class="chart">
  <h2>{text.chartTitle}</h2>
  <p class="legend">
    {plotted.map((v, i) => <span><i style={`background:${tone(i)}`}></i>{labName(v.lab)}</span>)}
  </p>
  {sizes.map((g) => (
  <svg viewBox={`0 0 ${g.W} ${g.H}`} class={g.cls} role="img" aria-label={text.chartTitle}>
    {[60, 120, 180].map((m) => (
      <g>
        <line x1={g.L} x2={g.W - g.R} y1={g.y(m)} y2={g.y(m)} class="grid" />
        <text x={g.L - 8} y={g.y(m) + 4} class="axis" text-anchor="end">{m / 60}h</text>
      </g>
    ))}
    <line x1={g.L} x2={g.W - g.R} y1={g.y(0)} y2={g.y(0)} class="base" />
    {weeks.map((w, i) => i % g.every === 0 && <text x={g.x(i)} y={g.H - 8} class="axis" text-anchor="middle">{weekLabel(w)}</text>)}
    {events.map(({ c, i }) => (
      <g class="event">
        <line x1={g.x(i)} x2={g.x(i)} y1={g.T} y2={g.y(0)} />
        <text x={g.x(i)} y={g.T - 4} text-anchor="middle" class={`mark ${c.data.direction}`}>{MARK[c.data.direction]}</text>
        <title>{`${isoDate(c.data.date)} ${labName(c.data.lab)}: ${titleFor(c, lang)}`}</title>
      </g>
    ))}
    {plotted.map((v, i) => {
      const last = v.minutes.length - 1;
      return (
        <g>
          <path d={path(g, v.minutes)} fill="none" stroke={tone(i)} stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
          <circle cx={g.x(last)} cy={g.y(v.minutes[last]!)} r="4" fill={tone(i)} class="end" />
          <text x={g.x(last) + 10} y={g.y(v.minutes[last]!) + 4} class="label">{g.cls === 'wide' ? `${labName(v.lab)} ` : ''}{duration(v.minutes[last]!)}</text>
        </g>
      );
    })}
    {weeks.map((w, i) => (
      <rect x={g.x(i) - g.step / 2} y={g.T} width={g.step} height={g.H - g.T - g.B} class="hit">
        <title>{[weekLabel(w), ...plotted.map((v) => `${labName(v.lab)} ${v.minutes[i] === null ? '–' : duration(v.minutes[i]!)}`)].join('\n')}</title>
      </rect>
    ))}
  </svg>
  ))}
  <p class="note">{text.eventsNote}{nowFelt && ` ${text.feel(nowFelt.pct)}`}</p>
</section>

<section>
  <h2>{text.changesTitle}</h2>
  <ul class="rows">
    {latest.map((c) => (
      <li>
        <a class="row" href={`${prefix}/changes#${c.id}`}>
          <span class="muted">{labName(c.data.lab)}</span>
          <time class="muted" datetime={isoDate(c.data.date)}>{isoDate(c.data.date)}</time>
          <span class={`mark ${c.data.direction}`}>{MARK[c.data.direction]}</span>
          <span class="title">{titleFor(c, lang)}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<section class="links">
  <a class="u" href={`${prefix}/limits`}>{text.byPlan} →</a>
  <a class="u" href={`${prefix}/changes`}>{text.allChanges} →</a>
  <a class="u" href={`${prefix}/share`}>{text.share} →</a>
</section>

<style>
  .hero { padding: 56px 0 8px; }
  h1 { font-size: 28px; font-weight: 500; line-height: 1.3; margin: 0 0 16px; letter-spacing: -0.01em; }
  h1 .mark { margin-right: 4px; }
  .sub { margin: 0; max-width: 64ch; color: var(--muted); }
  .tag { margin-left: 12px; padding: 1px 6px; border: 1px solid var(--line); font-size: var(--s-sm); color: var(--fg); white-space: nowrap; }
  h2 { font-size: var(--s-sm); font-weight: 400; color: var(--muted); margin: 0; padding-bottom: 8px; border-bottom: 1px solid var(--line); }
  section + section { margin-top: 48px; }
  .muted { color: var(--muted); }
  .small { font-size: var(--s-sm); }
  .u { text-decoration: underline; text-underline-offset: 3px; }
  .mark { font-weight: 500; }
  .mark.tighter, .tighter { color: var(--minus); }
  .mark.looser, .looser { color: var(--plus); }
  .mark.neutral, .mark.mixed { color: var(--muted); }

  .verdicts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); margin-top: 40px; }
  .verdict { display: grid; gap: 4px; align-content: start; padding: 20px 20px 20px 0; }
  .verdict + .verdict { padding-left: 20px; border-left: 1px solid var(--line); }
  .verdict .lab { font-size: var(--s-sm); color: var(--muted); }
  .verdict .big { font-size: 22px; font-weight: 500; line-height: 1.3; margin-bottom: 4px; }
  .verdict .big.muted { font-size: var(--s-lg); font-weight: 400; }

  .legend { display: flex; gap: 20px; margin: 12px 0 0; font-size: var(--s-sm); color: var(--muted); }
  .legend i { display: inline-block; width: 12px; height: 2px; margin-right: 8px; vertical-align: middle; }
  svg { display: block; width: 100%; height: auto; margin-top: 8px; overflow: visible; }
  svg.narrow { display: none; }
  .grid { stroke: var(--line); stroke-width: 1; }
  .base { stroke: var(--muted); stroke-width: 1; }
  .axis { fill: var(--muted); font: 12px var(--font); }
  .label { fill: var(--fg); font: 13px var(--font); }
  .end { stroke: var(--bg); stroke-width: 2; }
  .event line { stroke: var(--muted); stroke-width: 1; stroke-dasharray: 2 3; }
  .event text { font: 500 14px var(--font); fill: var(--muted); }
  .event text.tighter { fill: var(--minus); }
  .event text.looser { fill: var(--plus); }
  .hit { fill: transparent; }
  .hit:hover { fill: var(--hover); fill-opacity: 0.6; }
  .note { font-size: var(--s-sm); color: var(--muted); margin: 8px 0 0; max-width: 72ch; }

  .rows { list-style: none; margin: 0; padding: 0; }
  .row { display: grid; grid-template-columns: 11ch 11ch 2ch minmax(0, 1fr); gap: 16px; padding: 9px 0; border-bottom: 1px solid var(--line); }
  .row:hover { background: var(--hover); text-decoration: none; }
  .row .mark { text-align: center; }
  .links { display: flex; flex-wrap: wrap; gap: 12px 28px; font-size: var(--s-sm); }

  @media (max-width: 640px) {
    .hero { padding: 32px 0 0; }
    h1 { font-size: 22px; }
    .verdicts { grid-template-columns: 1fr; margin-top: 28px; }
    .verdict { padding: 16px 0; }
    .verdict + .verdict { padding-left: 0; border-left: 0; border-top: 1px solid var(--line); }
    .verdict .big { font-size: 20px; }
    svg.wide { display: none; }
    svg.narrow { display: block; }
    .row { grid-template-columns: 2ch minmax(0, 1fr); gap: 2px 12px; }
    .row .muted { grid-column: 2; font-size: var(--s-sm); }
    .row time { display: none; }
    .row .mark { grid-row: 2; grid-column: 1; }
    .row .title { grid-column: 2; }
  }
</style>
