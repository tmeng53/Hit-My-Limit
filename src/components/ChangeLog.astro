---
import { BUTTONDOWN_USER, LABS, SUBMIT_URL, formatDate, summaryFor, t, titleFor, type Change, type Lang } from '../lib/site';

interface Props {
  lang: Lang;
  changes: Change[];
}
const { lang, changes } = Astro.props;
const s = t[lang];
const arrow = { tighter: '↓', looser: '↑', mixed: '↕', neutral: '' } as const;
---
<section class="intro">
  <h1>{s.headline}</h1>
  <p>{s.lead}</p>
  <form action={`https://buttondown.com/api/emails/embed-subscribe/${BUTTONDOWN_USER}`} method="post" target="_blank">
    <label for="email" class="sr">{s.alerts}</label>
    <input id="email" type="email" name="email" required placeholder={s.emailPlaceholder} />
    <input type="hidden" name="tag" value={lang} />
    <button type="submit">{s.subscribe}</button>
  </form>
</section>

<div class="filters" role="group" aria-label="Lab">
  <button type="button" data-filter="all" aria-pressed="true">{s.all}</button>
  {Object.entries(LABS).map(([key, names]) => (
    <button type="button" data-filter={key} aria-pressed="false">{names[lang]}</button>
  ))}
</div>

<ol class="log">
  {changes.map((c) => (
    <li data-lab={c.data.lab} id={c.id}>
      <time datetime={c.data.date.toISOString().slice(0, 10)}>{formatDate(c.data.date, lang)}</time>
      <div>
        <p class="meta">
          {LABS[c.data.lab][lang]} · {c.data.product}
          {c.data.direction !== 'neutral' && <span class={`dir ${c.data.direction}`}>{arrow[c.data.direction]} {s[c.data.direction]}</span>}
          {c.data.direction === 'neutral' && <span class="dir">{s.display}</span>}
        </p>
        <h2><a href={`#${c.id}`}>{titleFor(c, lang)}</a></h2>
        <p class="summary">{summaryFor(c, lang)}</p>
        <p class="meta">
          <a class="src" href={c.data.source_url} rel="nofollow noopener">{c.data.source_name} ↗</a>
          {c.data.status === 'unconfirmed' && <span title={s.unconfirmedHint}> · {s.unconfirmed}</span>}
        </p>
      </div>
    </li>
  ))}
</ol>

<p class="more"><a href={SUBMIT_URL}>{s.submit} →</a></p>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('.log li');
  for (const b of buttons) {
    b.addEventListener('click', () => {
      const f = b.dataset.filter;
      for (const x of buttons) x.setAttribute('aria-pressed', String(x === b));
      for (const li of items) li.hidden = f !== 'all' && li.dataset.lab !== f;
    });
  }
</script>

<style>
  .intro { padding: 64px 0 48px; }
  h1 { font-size: var(--s-xl); font-weight: 600; line-height: 1.2; letter-spacing: -0.02em; margin: 0 0 16px; }
  .intro p { color: var(--muted); font-size: var(--s-lg); margin: 0 0 32px; max-width: 34em; }
  form { display: flex; gap: 8px; max-width: 400px; }
  input[type='email'], form button {
    height: 40px; padding: 0 16px; font: inherit; border-radius: 8px;
  }
  input[type='email'] { flex: 1; min-width: 0; border: 1px solid var(--line); background: transparent; color: inherit; }
  input[type='email']:focus { outline: none; border-color: var(--fg); }
  form button { border: 0; background: var(--fg); color: var(--bg); font-weight: 500; cursor: pointer; }

  .filters { display: flex; gap: 24px; border-bottom: 1px solid var(--line); }
  .filters button {
    padding: 0 0 12px; margin-bottom: -1px; border: 0; border-bottom: 1px solid transparent;
    background: none; color: var(--muted); font: inherit; font-size: var(--s-sm); cursor: pointer;
  }
  .filters button[aria-pressed='true'] { color: var(--fg); border-bottom-color: var(--fg); }

  .log { list-style: none; margin: 0; padding: 0; }
  .log li { display: grid; grid-template-columns: 112px 1fr; gap: 24px; padding: 24px 0; border-bottom: 1px solid var(--line); scroll-margin-top: 16px; }
  time { color: var(--muted); font-size: var(--s-sm); padding-top: 2px; }
  .meta { margin: 0; font-size: var(--s-sm); color: var(--muted); }
  .dir { margin-left: 8px; }
  .dir.tighter { color: var(--accent); }
  h2 { font-size: var(--s-lg); font-weight: 600; line-height: 1.4; margin: 4px 0 8px; letter-spacing: -0.01em; }
  .summary { margin: 0 0 8px; }
  .src { text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 3px; }
  .more { font-size: var(--s-sm); color: var(--muted); padding: 24px 0 0; margin: 0; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  @media (max-width: 560px) {
    .intro { padding: 40px 0 32px; }
    .log li { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
