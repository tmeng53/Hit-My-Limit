---
import { BUTTONDOWN_USER, LABS, MARK, isoDate, summaryFor, t, titleFor, type Change, type Lang } from '../lib/site';

interface Props {
  lang: Lang;
  changes: Change[];
}
const { lang, changes } = Astro.props;
const s = t[lang];
const legend = { tighter: s.tighter, looser: s.looser, mixed: s.mixed, neutral: s.displayOnly };
const latest = (Object.keys(LABS) as (keyof typeof LABS)[])
  .map((lab) => changes.find((c) => c.data.lab === lab))
  .filter((c): c is Change => !!c)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<section class="intro">
  <h1>{s.lead}</h1>
  <form action={`https://buttondown.com/api/emails/embed-subscribe/${BUTTONDOWN_USER}`} method="post" target="_blank">
    <label for="email">{s.alertsLead}</label>
    <div>
      <input id="email" type="email" name="email" required placeholder={s.emailPlaceholder} />
      <input type="hidden" name="tag" value={lang} />
      <button type="submit">{s.subscribe}</button>
    </div>
  </form>
</section>

<section>
  <h2>{s.latest}</h2>
  <ul class="rows">
    {latest.map((c) => (
      <li>
        <a class="row" href={`#${c.id}`}>
          <span class="lab">{LABS[c.data.lab][lang]}</span>
          <time datetime={isoDate(c.data.date)}>{isoDate(c.data.date)}</time>
          <span class={`mark ${c.data.direction}`}>{MARK[c.data.direction]}</span>
          <span class="title">{titleFor(c, lang)}</span>
          <span class="ago" data-date={isoDate(c.data.date)}></span>
        </a>
      </li>
    ))}
  </ul>
</section>

<section>
  <div class="bar">
    <h2>{s.log}</h2>
    <div class="filters" role="group" aria-label="Lab">
      <button type="button" data-filter="all" aria-pressed="true">{s.all}</button>
      {Object.entries(LABS).map(([key, names]) => (
        <button type="button" data-filter={key} aria-pressed="false">{names[lang]}</button>
      ))}
    </div>
  </div>
  <p class="legend">
    {Object.entries(legend).map(([k, label]) => (
      <span><span class={`mark ${k}`}>{MARK[k as keyof typeof MARK]}</span> {label}</span>
    ))}
  </p>

  <ol class="rows log">
    {changes.map((c) => (
      <li data-lab={c.data.lab} id={c.id}>
        <details>
          <summary class="row">
            <span class="lab">{LABS[c.data.lab][lang]}</span>
            <time datetime={isoDate(c.data.date)}>{isoDate(c.data.date)}</time>
            <span class={`mark ${c.data.direction}`}>{MARK[c.data.direction]}</span>
            <span class="title">{titleFor(c, lang)}</span>
          </summary>
          <div class="body">
            <p>{summaryFor(c, lang)}</p>
            <p class="meta">
              {c.data.product}
              {c.data.plans.length > 0 && <> · {s.plans}: {c.data.plans.join(', ')}</>}
              {' · '}{s[c.data.date_kind]} {isoDate(c.data.date)}
            </p>
            <p class="meta">
              <a href={c.data.source_url} rel="nofollow noopener">{c.data.source_name} ↗</a>
              {c.data.status === 'unconfirmed' && <span title={s.unconfirmedHint}> · {s.unconfirmed}: {s.unconfirmedHint}</span>}
            </p>
          </div>
        </details>
      </li>
    ))}
  </ol>
</section>

<script define:vars={{ dayAgo: s.dayAgo, daysAgo: s.daysAgo, today: s.today }}>
  const buttons = document.querySelectorAll('[data-filter]');
  const items = document.querySelectorAll('.log li');
  for (const b of buttons) {
    b.addEventListener('click', () => {
      const f = b.dataset.filter;
      for (const x of buttons) x.setAttribute('aria-pressed', String(x === b));
      for (const li of items) li.hidden = f !== 'all' && li.dataset.lab !== f;
    });
  }

  // Relative age of each lab's latest change, computed in the visitor's browser.
  const now = Date.now();
  for (const el of document.querySelectorAll('.ago')) {
    const days = Math.floor((now - Date.parse(el.dataset.date)) / 86400000);
    el.textContent = days < 1 ? today : days === 1 ? dayAgo : `${days} ${daysAgo}`;
  }

  // Open the entry a link points to.
  function openHash() {
    const id = decodeURIComponent(location.hash.slice(1));
    const li = id && document.getElementById(id);
    if (li && li.matches('.log li')) {
      for (const x of buttons) x.setAttribute('aria-pressed', String(x.dataset.filter === 'all'));
      for (const x of items) x.hidden = false;
      li.querySelector('details').open = true;
      li.scrollIntoView({ block: 'start' });
    }
  }
  addEventListener('hashchange', openHash);
  openHash();
</script>

<style>
  .intro { padding: 48px 0 8px; }
  h1 { font-size: var(--s-lg); font-weight: 500; line-height: 1.5; margin: 0 0 32px; max-width: 30em; }
  h2 { font-size: var(--s-sm); font-weight: 400; color: var(--muted); margin: 0; }
  section + section { margin-top: 48px; }
  section > h2 { padding-bottom: 8px; border-bottom: 1px solid var(--line); }

  form label { display: block; font-size: var(--s-sm); color: var(--muted); margin-bottom: 8px; }
  form div { display: flex; max-width: 440px; border: 1px solid var(--fg); }
  input[type='email'], form button { height: 40px; padding: 0 12px; font: inherit; border: 0; border-radius: 0; }
  input[type='email'] { flex: 1; min-width: 0; background: transparent; color: inherit; }
  input[type='email']:focus { outline: none; background: var(--hover); }
  form button { background: var(--fg); color: var(--bg); cursor: pointer; }

  .rows { list-style: none; margin: 0; padding: 0; }
  .rows > li { border-bottom: 1px solid var(--line); scroll-margin-top: 16px; }
  .row {
    display: grid;
    grid-template-columns: 10ch 11ch 2ch 1fr auto;
    gap: 0 16px;
    align-items: baseline;
    padding: 10px 0;
    cursor: pointer;
    list-style: none;
  }
  .row::-webkit-details-marker { display: none; }
  .row:hover { background: var(--hover); }
  .lab, time, .ago { color: var(--muted); }
  .mark { font-weight: 500; text-align: center; }
  .mark.tighter { color: var(--minus); }
  .mark.looser { color: var(--plus); }
  .mark.neutral { color: var(--muted); }
  .ago { font-size: var(--s-sm); }
  details[open] .title { font-weight: 500; }

  .body { padding: 0 0 20px calc(21ch + 32px + 2ch + 16px); max-width: calc(21ch + 64px + 62ch); }
  .body p { margin: 0 0 8px; }
  .body .meta { font-size: var(--s-sm); color: var(--muted); margin: 0; }
  .body a { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--line); }

  .bar { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding-bottom: 8px; border-bottom: 1px solid var(--line); flex-wrap: wrap; }
  .filters { display: flex; gap: 16px; }
  .filters button { padding: 0; border: 0; background: none; color: var(--muted); font: inherit; font-size: var(--s-sm); cursor: pointer; }
  .filters button[aria-pressed='true'] { color: var(--fg); text-decoration: underline; text-underline-offset: 4px; }
  .legend { display: flex; gap: 4px 20px; flex-wrap: wrap; margin: 0; padding: 8px 0; font-size: var(--s-sm); color: var(--muted); border-bottom: 1px solid var(--line); }

  @media (max-width: 640px) {
    .intro { padding: 24px 0 0; }
    .row { grid-template-columns: 2ch 1fr; gap: 2px 8px; padding: 12px 0; }
    .row .lab, .row time { grid-row: 1; font-size: var(--s-sm); }
    .row .lab { grid-column: 2; }
    .row time { grid-column: 2; justify-self: end; }
    .row .mark { grid-row: 2; grid-column: 1; }
    .row .title { grid-row: 2; grid-column: 2; }
    .row .ago { grid-row: 1; grid-column: 2; justify-self: end; }
    .row:has(.ago) time { display: none; }
    .body { padding: 0 0 16px calc(2ch + 8px); }
  }
</style>
