---
import { BUTTONDOWN_USER, LABS, formatDate, formatDay, summaryFor, t, titleFor, type Change, type Lang } from '../lib/site';

interface Props {
  lang: Lang;
  changes: Change[];
}
const { lang, changes } = Astro.props;
const s = t[lang];
const glyph = { tighter: '↓', looser: '↑', mixed: '↕', neutral: '·' } as const;
const iso = (d: Date) => d.toISOString().slice(0, 10);

const labs = (Object.keys(LABS) as (keyof typeof LABS)[]).map((key) => {
  const own = changes.filter((c) => c.data.lab === key);
  return { key, name: LABS[key][lang], count: own.length, last: own[0]?.data.date };
});

// Group rows under a year heading.
const years = new Map<number, Change[]>();
for (const c of changes) {
  const y = c.data.date.getUTCFullYear();
  years.set(y, [...(years.get(y) ?? []), c]);
}
---
<section class="intro">
  <h1>{s.headline}</h1>
  <p>{s.lead}</p>
  <p class="new" hidden data-new-text={s.newSince(0)}></p>
</section>

<div class="labs" role="group" aria-label="Lab">
  <button type="button" data-filter="all" aria-pressed="true">
    <span class="lab">{s.all}</span>
    <span class="sub">{changes.length} {s.changes}</span>
    <span class="sub">{s.last} {formatDay(changes[0].data.date, lang)}</span>
  </button>
  {labs.map((l) => (
    <button type="button" data-filter={l.key} aria-pressed="false">
      <span class="lab">{l.name}</span>
      <span class="sub">{l.count} {s.changes}</span>
      {l.last && <span class="sub">{s.last} {formatDay(l.last, lang)}</span>}
    </button>
  ))}
</div>

<div class="bar">
  <p class="legend">
    <span class="tighter">↓ {s.tighter}</span>
    <span class="looser">↑ {s.looser}</span>
    <span>↕ {s.mixed}</span>
    <span>· {s.displayOnly}</span>
  </p>
  <button type="button" class="toggle" data-expand={s.expand} data-collapse={s.collapse}>{s.expand}</button>
</div>

{[...years].map(([year, rows]) => (
  <section class="year" data-year={year}>
    <h2>{year}</h2>
    <ol>
      {rows.map((c) => (
        <li data-lab={c.data.lab} data-date={iso(c.data.date)} id={c.id}>
          <details>
            <summary>
              <time datetime={iso(c.data.date)}>{formatDay(c.data.date, lang)}</time>
              <span class="who">{LABS[c.data.lab][lang]}</span>
              <span class={`dir ${c.data.direction}`} title={c.data.direction === 'neutral' ? s.displayOnly : s[c.data.direction]}>{glyph[c.data.direction]}</span>
              <span class="title">{titleFor(c, lang)}{c.data.status === 'unconfirmed' && <span class="tag"> {s.unconfirmed}</span>}</span>
            </summary>
            <div class="body">
              <p>{summaryFor(c, lang)}</p>
              <dl>
                <dt>{s[c.data.date_kind]}</dt><dd>{formatDate(c.data.date, lang)}</dd>
                <dt>{s.plans}</dt><dd>{c.data.product}{c.data.plans.length > 0 && ` · ${c.data.plans.join(', ')}`}</dd>
                <dt>{s.source}</dt><dd><a href={c.data.source_url} rel="nofollow noopener">{c.data.source_name} ↗</a></dd>
              </dl>
              {c.data.status === 'unconfirmed' && <p class="note">{s.unconfirmedHint}</p>}
            </div>
          </details>
        </li>
      ))}
    </ol>
  </section>
))}

<form class="alerts" action={`https://buttondown.com/api/emails/embed-subscribe/${BUTTONDOWN_USER}`} method="post" target="_blank">
  <label for="email">{s.emailLabel}</label>
  <div>
    <input id="email" type="email" name="email" required placeholder={s.emailPlaceholder} />
    <input type="hidden" name="tag" value={lang} />
    <button type="submit">{s.subscribe}</button>
  </div>
</form>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const rows = document.querySelectorAll<HTMLElement>('.year li');
  const years = document.querySelectorAll<HTMLElement>('.year');
  for (const b of buttons) {
    b.addEventListener('click', () => {
      const f = b.dataset.filter;
      for (const x of buttons) x.setAttribute('aria-pressed', String(x === b));
      for (const li of rows) li.hidden = f !== 'all' && li.dataset.lab !== f;
      for (const y of years) y.hidden = !y.querySelector('li:not([hidden])');
    });
  }

  const toggle = document.querySelector<HTMLButtonElement>('.toggle')!;
  const details = document.querySelectorAll<HTMLDetailsElement>('.year details');
  toggle.addEventListener('click', () => {
    const open = toggle.textContent === toggle.dataset.expand;
    for (const d of details) d.open = open;
    toggle.textContent = (open ? toggle.dataset.collapse : toggle.dataset.expand) ?? '';
  });

  // Open a linked entry.
  if (location.hash) {
    const d = document.getElementById(decodeURIComponent(location.hash.slice(1)))?.querySelector('details');
    if (d) d.open = true;
  }

  // Mark entries dated after the visitor's previous visit.
  try {
    const key = 'hml-last-visit';
    const prev = localStorage.getItem(key);
    localStorage.setItem(key, new Date().toISOString().slice(0, 10));
    if (prev) {
      const fresh = [...rows].filter((li) => (li.dataset.date ?? '') > prev);
      for (const li of fresh) li.classList.add('fresh');
      const note = document.querySelector<HTMLElement>('.new')!;
      if (fresh.length) {
        note.textContent = (note.dataset.newText ?? '').replace('0', String(fresh.length));
        note.hidden = false;
      }
    }
  } catch {}
</script>

<style>
  .intro { padding: 56px 0 32px; }
  h1 { font-size: var(--s-lg); font-weight: 500; margin: 0 0 8px; }
  .intro p { margin: 0; color: var(--muted); max-width: 40em; }
  .intro .new { margin-top: 16px; color: var(--fg); }
  .intro .new::before { content: ''; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--fg); margin-right: 8px; vertical-align: 2px; }

  /* Lab picker doubles as a summary: count and date of the latest change. */
  .labs { display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--line); border-radius: 6px; overflow: hidden; }
  .labs button {
    display: flex; flex-direction: column; gap: 0; align-items: flex-start; text-align: left;
    padding: 12px 16px; border: 0; border-left: 1px solid var(--line); background: none; color: var(--fg);
    font: inherit; cursor: pointer;
  }
  .labs button:first-child { border-left: 0; }
  .labs button[aria-pressed='true'] { background: var(--fg); color: var(--bg); }
  .labs button[aria-pressed='true'] .sub { color: inherit; opacity: 0.7; }
  .labs .lab { font-weight: 500; margin-bottom: 4px; }
  .labs .sub { font-size: var(--s-sm); color: var(--muted); }

  .bar { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 24px 0 8px; font-size: var(--s-sm); color: var(--muted); }
  .legend { display: flex; flex-wrap: wrap; gap: 16px; margin: 0; }
  .toggle { border: 0; padding: 0; background: none; color: inherit; font: inherit; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--line); white-space: nowrap; }
  .toggle:hover { color: var(--fg); }

  .year h2 { font-size: var(--s-sm); font-weight: 400; color: var(--muted); margin: 0; padding: 24px 0 8px; border-bottom: 1px solid var(--fg); }
  ol { list-style: none; margin: 0; padding: 0; }
  li { border-bottom: 1px solid var(--line); scroll-margin-top: 16px; }

  summary {
    display: grid; grid-template-columns: 64px 96px 16px 1fr; gap: 16px; align-items: baseline;
    padding: 12px 0; cursor: pointer; list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover .title { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--muted); }
  time, .who { color: var(--muted); }
  .fresh time { color: var(--fg); }
  .fresh time::after { content: ' •'; }
  .dir { text-align: center; color: var(--muted); }
  .tighter { color: var(--down); }
  .looser { color: var(--up); }
  .tag { font-size: var(--s-sm); color: var(--muted); }

  .body { padding: 0 0 20px calc(64px + 96px + 16px + 48px); }
  .body p { margin: 0 0 12px; max-width: 38em; }
  dl { display: grid; grid-template-columns: max-content 1fr; gap: 4px 16px; margin: 0; font-size: var(--s-sm); }
  dt { color: var(--muted); }
  dt::first-letter { text-transform: uppercase; }
  dd { margin: 0; }
  dd a { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--line); }
  .note { font-size: var(--s-sm); color: var(--muted); }

  .alerts { margin-top: 56px; padding: 24px; border: 1px solid var(--line); border-radius: 6px; }
  .alerts label { display: block; margin-bottom: 12px; }
  .alerts div { display: flex; gap: 8px; max-width: 440px; }
  .alerts input[type='email'], .alerts button { height: 40px; padding: 0 16px; font: inherit; border-radius: 6px; }
  .alerts input[type='email'] { flex: 1; min-width: 0; border: 1px solid var(--line); background: var(--bg); color: inherit; }
  .alerts input[type='email']:focus { outline: none; border-color: var(--fg); }
  .alerts button { border: 0; background: var(--fg); color: var(--bg); cursor: pointer; }

  @media (max-width: 640px) {
    .intro { padding: 32px 0 24px; }
    .labs { grid-template-columns: 1fr 1fr; }
    .labs button:nth-child(3) { border-left: 0; }
    .labs button:nth-child(n + 3) { border-top: 1px solid var(--line); }
    .bar .legend { gap: 12px; }
    summary { grid-template-columns: auto auto 1fr; gap: 4px 8px; }
    summary .dir { grid-row: 2; grid-column: 1; text-align: left; }
    summary .title { grid-row: 2; grid-column: 2 / -1; }
    .body { padding-left: 0; }
  }
</style>
