---
import { REPO_URL, SUBMIT_URL, t, type Lang } from '../lib/site';

interface Props {
  lang: Lang;
  title?: string;
}
const { lang, title } = Astro.props;
const s = t[lang];
const pageTitle = title ? `${title} · Hit My Limit` : `Hit My Limit · ${s.tagline}`;
const rss = lang === 'zh' ? '/zh/rss.xml' : '/rss.xml';
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={s.lead} />
    <link rel="alternate" type="application/rss+xml" title="Hit My Limit" href={rss} />
    <link rel="alternate" hreflang="en" href="/" />
    <link rel="alternate" hreflang="zh-CN" href="/zh/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header>
      <a class="name" href={lang === 'zh' ? '/zh/' : '/'}>Hit My Limit</a>
      <nav>
        <a href={SUBMIT_URL}>{s.submit}</a>
        <a href={rss}>{s.rss}</a>
        <a href={s.otherHref} lang={lang === 'zh' ? 'en' : 'zh-CN'}>{s.other}</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <a href={REPO_URL}>GitHub</a>
      <span>{s.codeLicense}</span>
      <a href="https://creativecommons.org/licenses/by/4.0/">{s.dataLicense}</a>
    </footer>
  </body>
</html>

<style is:global>
  /* The whole design system: one typeface, four sizes, four colors, one spacing unit (8px). */
  :root {
    --bg: #ffffff;
    --fg: #111111;
    --muted: #6e6e6e;
    --line: #ebebeb;
    --accent: #e5484d;
    --font: 'Geist', 'PingFang SC', 'Noto Sans SC', 'Microsoft YaHei', system-ui, sans-serif;
    --s-sm: 13px;
    --s-md: 15px;
    --s-lg: 17px;
    --s-xl: 32px;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0a0a0a;
      --fg: #ededed;
      --muted: #8f8f8f;
      --line: #222222;
      --accent: #ff6369;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font: var(--s-md)/1.6 var(--font);
    font-feature-settings: 'tnum';
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-decoration: none; }
  a:hover { color: var(--muted); }
  header, main, footer { max-width: 720px; margin: 0 auto; padding: 0 24px; }
  header { display: flex; justify-content: space-between; align-items: center; gap: 16px; height: 64px; }
  .name { font-weight: 600; }
  header nav { display: flex; gap: 24px; font-size: var(--s-sm); color: var(--muted); }
  footer { display: flex; gap: 24px; flex-wrap: wrap; padding-top: 32px; padding-bottom: 48px; font-size: var(--s-sm); color: var(--muted); }
  @media (max-width: 520px) {
    header nav a:first-child { display: none; }
  }
</style>
