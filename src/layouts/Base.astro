---
import { REPO_URL, SUBMIT_URL, t, type Lang } from '../lib/site';

interface Props {
  lang: Lang;
  title?: string;
}
const { lang, title } = Astro.props;
const s = t[lang];
const pageTitle = title ? `${title} · Hit My Limit` : `Hit My Limit · ${s.tagline}`;
const rss = lang === 'zh' ? '/zh/rss.xml' : '/rss.xml';
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={s.lead} />
    <link rel="alternate" type="application/rss+xml" title="Hit My Limit" href={rss} />
    <link rel="alternate" hreflang="en" href="/" />
    <link rel="alternate" hreflang="zh-CN" href="/zh/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header>
      <a class="name" href={lang === 'zh' ? '/zh/' : '/'}>hitmylimit</a>
      <a href={s.otherHref} lang={lang === 'zh' ? 'en' : 'zh-CN'}>{s.other}</a>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <a href={SUBMIT_URL}>{s.submit}</a>
      <a href={rss}>{s.rss}</a>
      <a href={REPO_URL}>GitHub</a>
      <span>{s.codeLicense}</span>
      <a href="https://creativecommons.org/licenses/by/4.0/">{s.dataLicense}</a>
    </footer>
  </body>
</html>

<style is:global>
  /* One monospace typeface, three sizes, black and white plus the two diff colors. */
  :root {
    --bg: #ffffff;
    --fg: #000000;
    --muted: #707070;
    --line: #e6e6e6;
    --hover: #f5f5f5;
    --minus: #d1242f;
    --plus: #1a7f37;
    --font: 'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, 'PingFang SC', 'Noto Sans SC', 'Microsoft YaHei', monospace;
    --s-sm: 13px;
    --s-md: 14px;
    --s-lg: 18px;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0d0d0d;
      --fg: #f2f2f2;
      --muted: #8c8c8c;
      --line: #262626;
      --hover: #171717;
      --minus: #ff7b72;
      --plus: #56d364;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font: var(--s-md)/1.6 var(--font);
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-decoration: none; }
  a:hover { text-decoration: underline; text-underline-offset: 3px; }
  header, main, footer { max-width: 960px; margin: 0 auto; padding: 0 24px; }
  header { display: flex; justify-content: space-between; align-items: center; height: 56px; font-size: var(--s-sm); }
  header a:last-child { color: var(--muted); }
  .name { font-weight: 500; font-size: var(--s-md); }
  footer { display: flex; gap: 24px; flex-wrap: wrap; padding-top: 48px; padding-bottom: 48px; font-size: var(--s-sm); color: var(--muted); }
  @media (max-width: 640px) {
    header, main, footer { padding: 0 16px; }
    footer { gap: 8px 20px; padding-top: 40px; padding-bottom: 40px; }
  }
</style>
