---
import { REPO_URL, SUBMIT_URL, t, type Lang } from '../lib/site';

interface Props {
  lang: Lang;
  title?: string;
}
const { lang, title } = Astro.props;
const s = t[lang];
const pageTitle = title ? `${title} · Hit My Limit` : `Hit My Limit · ${s.tagline}`;
const rss = lang === 'zh' ? '/zh/rss.xml' : '/rss.xml';
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={s.lead} />
    <link rel="alternate" type="application/rss+xml" title="Hit My Limit" href={rss} />
    <link rel="alternate" hreflang="en" href="/" />
    <link rel="alternate" hreflang="zh-CN" href="/zh/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header>
      <a class="name" href={lang === 'zh' ? '/zh/' : '/'}>hitmylimit</a>
      <nav>
        <a href={SUBMIT_URL}>{s.submit}</a>
        <a href={rss}>{s.rss}</a>
        <a href={s.otherHref} lang={lang === 'zh' ? 'en' : 'zh-CN'}>{s.other}</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <a href={REPO_URL}>GitHub</a>
      <span>{s.codeLicense}</span>
      <a href="https://creativecommons.org/licenses/by/4.0/">{s.dataLicense}</a>
    </footer>
  </body>
</html>

<style is:global>
  /* One monospace typeface, three sizes, 8px spacing. Color carries meaning only: red = tighter, green = looser. */
  :root {
    --bg: #fbfbf9;
    --fg: #1a1a1a;
    --muted: #767676;
    --line: #e6e6e3;
    --down: #c4320a;
    --up: #2f7d32;
    --font: 'IBM Plex Mono', ui-monospace, 'PingFang SC', 'Noto Sans SC', 'Microsoft YaHei', monospace;
    --s-sm: 12px;
    --s-md: 14px;
    --s-lg: 16px;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #121212;
      --fg: #e8e8e6;
      --muted: #8c8c8a;
      --line: #2a2a2a;
      --down: #ff7a59;
      --up: #6cc070;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font: var(--s-md)/1.6 var(--font);
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-decoration: none; }
  a:hover { color: var(--muted); }
  header, main, footer { max-width: 840px; margin: 0 auto; padding: 0 24px; }
  header { display: flex; justify-content: space-between; align-items: center; gap: 16px; height: 56px; border-bottom: 1px solid var(--line); }
  .name { font-weight: 500; }
  header nav { display: flex; gap: 24px; font-size: var(--s-sm); color: var(--muted); }
  footer { display: flex; gap: 24px; flex-wrap: wrap; padding-top: 40px; padding-bottom: 48px; font-size: var(--s-sm); color: var(--muted); }
  @media (max-width: 520px) {
    header, main, footer { padding: 0 16px; }
    footer { padding-top: 32px; padding-bottom: 40px; }
    header nav { gap: 16px; }
  }
</style>
