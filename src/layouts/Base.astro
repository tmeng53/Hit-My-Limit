---
import { REPO_URL, t, type Lang } from '../lib/site';

interface Props {
  lang: Lang;
  title?: string;
}
const { lang, title } = Astro.props;
const s = t[lang];
const pageTitle = title ? `${title} · Hit My Limit` : 'Hit My Limit';
const rss = lang === 'zh' ? '/zh/rss.xml' : '/rss.xml';
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={s.tagline} />
    <link rel="alternate" type="application/rss+xml" title="Hit My Limit" href={rss} />
    <link rel="alternate" hreflang="en" href="/" />
    <link rel="alternate" hreflang="zh-CN" href="/zh/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header>
      <a class="brand" href={lang === 'zh' ? '/zh/' : '/'}>Hit My Limit</a>
      <nav>
        <a href={rss}>{s.rss}</a>
        <a href={s.otherHref} lang={lang === 'zh' ? 'en' : 'zh-CN'}>{s.other}</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <a href={REPO_URL}>GitHub</a>
      <span>{s.codeLicense}</span>
      <a href="https://creativecommons.org/licenses/by/4.0/">{s.dataLicense}</a>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbfaf8;
    --fg: #1d1c1a;
    --muted: #6b6862;
    --line: #e4e1db;
    --accent: #c2410c;
    --chip: #f1eee8;
    --warn: #a16207;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #161514;
      --fg: #ecebe8;
      --muted: #a3a09a;
      --line: #2e2c29;
      --accent: #fb923c;
      --chip: #24221f;
      --warn: #facc15;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font: 16px/1.55 system-ui, -apple-system, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  }
  a { color: inherit; }
  header, main, footer { max-width: 760px; margin: 0 auto; padding: 0 16px; }
  header { display: flex; justify-content: space-between; align-items: center; padding-top: 20px; }
  header nav { display: flex; gap: 16px; font-size: 14px; }
  .brand { font-weight: 700; text-decoration: none; letter-spacing: -0.01em; }
  footer { display: flex; gap: 16px; flex-wrap: wrap; padding: 32px 16px 48px; font-size: 13px; color: var(--muted); border-top: 1px solid var(--line); margin-top: 48px; }
</style>
