---
import { REPO_URL, SUBMIT_URL, t, type Lang } from '../lib/site';

interface Props {
  lang: Lang;
  title?: string;
}
const { lang, title } = Astro.props;
const s = t[lang];
const pageTitle = title ? `${title} · Hit My Limit` : `Hit My Limit · ${s.tagline}`;
const rss = lang === 'zh' ? '/zh/rss.xml' : '/rss.xml';
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={s.lead} />
    <link rel="alternate" type="application/rss+xml" title="Hit My Limit" href={rss} />
    <link rel="alternate" hreflang="en" href="/" />
    <link rel="alternate" hreflang="zh-CN" href="/zh/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="bar">
      <a class="mark" href={lang === 'zh' ? '/zh/' : '/'}>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><rect x="1" y="1" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"/><rect x="4" y="4" width="12" height="9" fill="var(--tighter)"/></svg>
        HIT MY LIMIT
      </a>
      <nav>
        <a href={SUBMIT_URL}>{s.submit}</a>
        <a href={rss}>{s.rss}</a>
        <a href={s.otherHref} lang={lang === 'zh' ? 'en' : 'zh-CN'}>{s.other}</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <span>hitmylimit.com</span>
      <a href={REPO_URL}>GitHub</a>
      <span>{s.codeLicense}</span>
      <a href="https://creativecommons.org/licenses/by/4.0/">{s.dataLicense}</a>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --paper: #f7f6f2;
    --ink: #121211;
    --muted: #66645e;
    --rule: #121211;
    --hair: #d9d6cd;
    --tighter: #d4351c;
    --looser: #13804f;
    --mixed: #8a6d1d;
    --serif: 'Instrument Serif', 'Songti SC', 'Noto Serif SC', Georgia, serif;
    --sans: 'IBM Plex Sans', 'PingFang SC', 'Noto Sans SC', 'Microsoft YaHei', system-ui, sans-serif;
    --mono: 'IBM Plex Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #0f0f0e;
      --ink: #eeede8;
      --muted: #9a978f;
      --rule: #eeede8;
      --hair: #2c2b28;
      --tighter: #ff5a3c;
      --looser: #34c47c;
      --mixed: #d6b04c;
    }
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font: 16px/1.5 var(--sans);
  }
  a { color: inherit; }
  .bar, main, footer { max-width: 1040px; margin: 0 auto; padding: 0 20px; }
  .bar {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding-top: 18px; padding-bottom: 14px;
    border-bottom: 1.5px solid var(--rule);
    font-family: var(--mono); font-size: 13px;
  }
  .mark { display: inline-flex; align-items: center; gap: 10px; font-weight: 500; letter-spacing: 0.12em; text-decoration: none; white-space: nowrap; }
  .bar nav { display: flex; gap: 18px; flex-wrap: wrap; justify-content: flex-end; }
  .bar nav a { text-decoration: none; }
  .bar nav a:hover { text-decoration: underline; text-underline-offset: 3px; }
  footer {
    display: flex; gap: 20px; flex-wrap: wrap;
    margin-top: 64px; padding-top: 14px; padding-bottom: 48px;
    border-top: 1.5px solid var(--rule);
    font-family: var(--mono); font-size: 12px; color: var(--muted);
  }
  @media (max-width: 560px) {
    .bar nav a:first-child { display: none; }
  }
</style>
